# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# กำหนดชื่อฐานข้อมูลแยกเฉพาะสำหรับโปรเจกต์นี้ (เพื่อป้องกันการปะปนกับโปรเจกต์อื่นบนคลัสเตอร์ Atlas เดียวกัน)
MONGODB_DB_NAME=youtube_cinematic_donghua_studio
MONGODB_GRIDFS_BUCKET=youtube_studio_media

# Optional: Google Gemini API Key for direct AI script & prompt generation
# (If not provided, the studio uses its built-in advanced narrative engine template)
GEMINI_API_KEY=

# App URL (automatically set on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
